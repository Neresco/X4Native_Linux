# Runtime downloads require an account that owns X4. Do not commit .env/secrets.
X4_GAME_SOURCE=steam
X4_STEAM_USERNAME=
# X4_STEAM_PASSWORD_FILE=/run/secrets/steam-password
# Complete Steam Guard in auth mode or provide a short-lived code via _FILE.
# X4_STEAM_GUARD_CODE_FILE=/run/secrets/steam-guard
X4_STEAM_UPDATE=missing
X4_STEAM_BRANCH=public
X4_GAME_VERSION=900
# The official NoSteam executable also needs Egosoft registered ownership.
# Choose an authorized HTTPS URL (_FILE supported) or the supplied archive.
# X4_NOSTEAM_URL_FILE=/run/secrets/nosteam-url
# X4_EGOSOFT_COOKIE_FILE=/run/secrets/egosoft-cookies
X4_NOSTEAM_ARCHIVE=/downloads/X4_9.00_nonsteam_Linux.zip
X4_SAVE=save_001
X4_NEW_GAME=x4ep1_gamestart_trade
X4_AUTOSAVE_SECONDS=300
X4_SHUTDOWN_SAVE_TIMEOUT=60
X4_RUN_SECONDS=1800
X4_RENDER_THREADS=2
X4_FRAME_RATE=15
X4_WIDTH=1280
X4_HEIGHT=720
X4_DRAW_SUPPRESS=1
X4MP_TRANSPORT=tcp
X4MP_LEGACY_NET=0
X4MP_STREAMS=0
X4MP_STREAMSHIPS=0
X4MP_FULLSIM=0
X4MP_PORT=7777
X4MP_STREAM_PORT=7778
X4_CPU_LIMIT=2
X4_MEMORY_LIMIT=12g
X4_UID=1000
X4_GID=100
# Bind paths are deployment choices; keep private data outside source/image.
# X4_STORAGE_ROOT=/path/to/private/x4
# X4_DOWNLOADS_ROOT=/path/to/private/downloads
# X4_SECRET_ROOT=/path/to/private/secrets
